# 스테이징 부하·모니터링 서버용 .env 템플릿
#
# 사용법: 부하·모니터링 서버에서 이 파일을 .env로 복사해 값을 채운다.
#   cp .env.staging-ops.example .env && vi .env
#   sed -i 's/<APP_HOST>/<앱서버-사설IP>/' monitoring/prometheus/prometheus-staging.yml
#   docker compose -f docker-compose.staging-ops.yml up -d
#
# 부하 실행:
#   docker compose -f docker-compose.staging-ops.yml --profile load-test \
#       run --rm k6 run /scripts/<시나리오>.js --env BASE_URL=http://<앱서버-사설IP>:8080

# ── 대상 호스트 (모두 사설 IP) ─────────────────────────────────────
# 공인 IP를 쓰면 트래픽이 밖으로 나갔다 들어와 지연이 왜곡된다.
APP_HOST=<앱서버-사설IP>
RDS_HOST=<RDS-엔드포인트>
REDIS_HOST=<Redis-사설IP>

# ── postgres-exporter가 RDS에 붙을 자격증명 ────────────────────────
# sslmode=require는 compose에 이미 지정돼 있다(RDS 기본값).
# pg_stat_statements를 쓰려면 RDS 파라미터 그룹에
# shared_preload_libraries에 추가하고 재부팅해야 한다.
POSTGRES_DB=<db명>
POSTGRES_USER=<사용자>
POSTGRES_PASSWORD=<비밀번호>

# ── Grafana ────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=<비밀번호>

# 참고: prometheus-staging.yml의 <APP_HOST> 플레이스홀더는 .env로 치환되지 않는다.
# Prometheus 설정 파일은 환경변수 확장을 지원하지 않으므로 파일을 직접 고쳐야 한다.
