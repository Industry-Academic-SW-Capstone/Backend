# 스테이징 Kafka 서버용 .env 템플릿
#
# 사용법: Kafka 서버에서 이 파일을 .env 로 복사해 값을 채운다.
#   cp .env.staging-kafka.example .env && vi .env
#   docker compose -f docker-compose.staging-kafka.yml up -d
#
# 앱 서버의 KAFKA_BOOTSTRAP_SERVERS 는 <이 값>:9092 가 된다.

# 이 서버의 사설 IP. 공인 IP 를 쓰면 트래픽이 밖으로 나갔다 들어와 지연이 왜곡된다.
KAFKA_ADVERTISED_HOST=<Kafka-사설IP>
