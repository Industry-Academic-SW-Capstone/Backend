# 스테이징 앱 서버용 .env 템플릿
#
# 사용법: 앱 서버에서 이 파일을 .env로 복사해 값을 채운다.
#   cp .env.staging-app.example .env && vi .env
#   docker compose -f docker-compose.staging-app.yml up -d --build
#
# .env는 .gitignore 대상이라 clone해도 따라오지 않는다. 인스턴스마다 직접 만든다.

# ── 필수: 비면 앱이 기동하지 않거나 핵심 기능이 막힌다 ──────────────

# 비면 기동 실패(fail-fast). 도메인이 없으므로 앱 서버 사설 IP를 쓴다.
APP_CORS_ALLOWED_ORIGINS=http://<앱서버-사설IP>:8080

# 비면 /api/batch-jobs가 fail-closed → 종목 마스터 적재 불가 → k6 setup이 전량 실패한다.
APP_ADMIN_EMAILS=<본인 이메일>

# ── RDS ────────────────────────────────────────────────────────────
POSTGRES_DB=<db명>
POSTGRES_USER=<사용자>
POSTGRES_PASSWORD=<비밀번호>
POSTGRES_URL=jdbc:postgresql://<RDS-엔드포인트>:5432/<db명>

# ── Redis ──────────────────────────────────────────────────────────
# 분리하면서 반드시 바뀌는 값. localhost나 redis가 아니라 사설 IP다.
SPRING_REDIS_HOST=<Redis-사설IP>
SPRING_REDIS_PORT=6379

# ── KIS API ────────────────────────────────────────────────────────
# 종목 마스터 적재에 실제 키가 필요하다.
KIS_API_APPKEY=<발급키>
KIS_API_APPSECRET=<발급시크릿>

JWT_SECRET=<32자 이상 임의 문자열>

# ── 벤치마크 스위치: 증분 매트릭스 R0~R3을 이 두 값으로 만든다 ──────
#   R0  jpa   / jpa    매칭 경로에 Redis 0개
#   R1  redis / jpa    큐만 Redis
#   R2  jpa   / redis  오더북만 Redis
#   R3  redis / redis  현행
MATCHING_QUEUE_BACKEND=redis
MATCHING_ORDERBOOK_BACKEND=redis

# 체결 이벤트 1건이 훑을 오더북 후보 수. 임계 구역 길이에 직접 영향을 준다.
MATCHING_LIMIT_ORDER_FETCH_SIZE=100

# ── 선택: 벤치마크에 불필요하므로 비워도 된다 ──────────────────────
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
FIREBASE_CREDENTIALS_BASE64=
GEMINI_API_KEY=
PYTHON_ANALYSIS_URL=
