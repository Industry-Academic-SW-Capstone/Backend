# EC2 의 배포 디렉터리에 .env 로 복사해 값을 채운다. docker-compose.prod.yml 이 읽는다. 저장소에 올리지 않는다.

# 이미지
DOCKER_USERNAME=
BACKEND_TAG=toss
AI_TAG=toss

# 도메인 (Traefik 이 Let's Encrypt 인증서를 받는다. DNS A 레코드가 이 서버를 가리켜야 한다)
API_DOMAIN=

# PostgreSQL (첫 기동 때 이 값으로 계정·DB 가 만들어진다. 이후 바꾸려면 DB 안에서 직접 바꿔야 한다)
POSTGRES_DB=stockit
POSTGRES_USER=stockit
POSTGRES_PASSWORD=
# 뉴스 RAG 용 stock_news DB 의 stockai 계정 비밀번호
NEWS_DB_PASSWORD=

# 외부 API
KIS_API_APPKEY=
KIS_API_APPSECRET=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
GEMINI_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
CLAUDE_API_KEY=
DART_API_KEY=
FIREBASE_CREDENTIALS_BASE64=

# 보안
JWT_SECRET=
# 쉼표 구분. 비면 기동 실패
APP_CORS_ALLOWED_ORIGINS=
# 쉼표 구분. 비면 관리자 API 를 아무도 못 쓴다
APP_ADMIN_EMAILS=

# 빈 DB 첫 배포 때만 true (KIS 종목 마스터 수집). 받은 뒤 false 로 되돌린다
APP_RUN_MASTER_UPDATE_ON_STARTUP=false
