      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(matching_settlement_seconds_bucket{job=\"spring-boot\"}[1m])) by (le))",
          "legendFormat": "p99",
          "refId": "A"
        }
      ]
    },
