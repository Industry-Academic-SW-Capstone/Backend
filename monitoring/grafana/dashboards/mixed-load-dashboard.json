    "benchmark"
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Assets API — 사용자 영향",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Assets API Latency",
      "description": "자산 조회 API(GET /api/accounts/{id}/assets) 중 성공한 요청의 응답 시간. k6(사용자 쪽)에서 잰 값이라 톰캣 대기열에서 기다린 시간까지 포함한다. 실패한 요청은 옆의 Error Rate 패널에서 본다. 선: SLO p95 300ms(주황), p99 500ms(빨강). 주의: k6 백분위는 회차 시작부터 누적한 값이다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.3
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "k6_http_req_duration_p50{scenario=\"user\",expected_response=\"true\"}",
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "k6_http_req_duration_p95{scenario=\"user\",expected_response=\"true\"}",
          "legendFormat": "p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "k6_http_req_duration_p99{scenario=\"user\",expected_response=\"true\"}",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Assets API Error Rate",
      "description": "자산 조회 중 2xx 가 아닌 응답의 비율. 5xx 와 k6 타임아웃(status 0)을 포함한다. 빨간 선: SLO 0.1%.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 0.001
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(sum(rate(k6_http_reqs_total{scenario=\"user\",status!~\"2..\"}[1m])) or vector(0)) / sum(rate(k6_http_reqs_total{scenario=\"user\"}[1m]))",
          "legendFormat": "error rate"
        }
      ]
    },
    {
      "id": 4,
      "type": "row",
      "title": "Matching — 부하와 처리",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Matching Throughput",
      "description": "받은 속도(k6 가 2xx 를 받은 요청)와 처리한 속도. 큐를 켜면 받은 것 = 큐에 넣은 것(202), 처리한 것 = 체결 워커가 끝낸 것. 두 선의 차이만큼 lag 이 쌓인다. 큐를 끄면 받은 것 = 처리한 것(200)이라 두 선이 겹친다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(k6_http_reqs_total{scenario=\"fill\",status=~\"2..\"}[1m]))",
          "legendFormat": "received"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum(rate(spring_kafka_listener_seconds_count{job=\"spring-boot\",name=~\"matching-fill-.*\",result=\"success\"}[1m])) or sum(rate(k6_http_reqs_total{scenario=\"fill\",status=\"200\"}[1m]))",
          "legendFormat": "processed"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Consumer Lag",
      "description": "큐에 쌓여 아직 처리하지 못한 메시지 수(브로커 기준, 컨슈머가 죽어도 보인다). 처리 한계를 넘으면 오르고, 부하가 끝나면 0 으로 내려와야 한다. 0 으로 돌아오는 데 걸린 시간 = 비우는 시간. 정산 lag 이 계속 오르면 정산 워커가 체결을 못 따라가는 것이다. 커밋된 offset 이 없는 파티션은 exporter 가 -1 로 보고하므로 0 으로 올려 더한다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": true
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(clamp_min(kafka_consumergroup_lag{consumergroup=\"matching-fill\"}, 0)) or vector(0)",
          "legendFormat": "fill"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum(clamp_min(kafka_consumergroup_lag{consumergroup=\"settlement\"}, 0)) or vector(0)",
          "legendFormat": "settlement"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Fill End-to-End Latency",
      "description": "체결 명령을 큐에 넣은 뒤 체결이 커밋될 때까지(p99, 그 순간의 값 — k6 패널처럼 누적값이 아니다). queue wait = 그중 큐에서 기다린 시간. 빨간 선 = 1초(천장 아래 구간의 목표). 천장 위에서는 lag 만큼 길어진다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(matching_fill_e2e_seconds_bucket{job=\"spring-boot\"}[1m])))",
          "legendFormat": "end-to-end p99"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(matching_fill_queue_wait_seconds_bucket{job=\"spring-boot\"}[1m])))",
          "legendFormat": "queue wait p99"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Matching Lost Events",
      "description": "회차 시작부터 처리하지도 큐에 넣지도 못한 체결 이벤트의 누적 건수(k6 의 2xx 가 아닌 응답). 목표는 0건. 큐를 켜면 503 = 1초 안에 브로커 기록 확인을 못 받음 — 늦게라도 기록됐을 수 있어 최종 판정은 회차 후 SQL 대조로 한다. 500 = JWT 필터(인증) 단계의 커넥션 타임아웃. k6 를 다시 실행하면 0 부터 다시 센다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": true
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(k6_http_reqs_total{scenario=\"fill\",status!~\"2..\"}) or vector(0)",
          "legendFormat": "lost events"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Settlement Delay",
      "description": "체결이 커밋된 뒤 정산이 커밋될 때까지(p99) = 잔고에 늦게 반영되는 시간. 정산 워커가 따로 돌아서 생기는 대가.",
      "datasource": {
