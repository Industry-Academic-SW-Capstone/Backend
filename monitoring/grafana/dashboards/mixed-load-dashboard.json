      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (scenario, status) (rate(k6_http_reqs_total[1m]))",
          "legendFormat": "{{scenario}} {{status}}"
